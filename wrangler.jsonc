{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chapterly",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chapterly-db",
			// Before deploying, replace with the ID from `npx wrangler d1 create chapterly-db`
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "drizzle"
		},
		{
			"binding": "chapterly_db",
			"database_name": "chapterly-db",
			"database_id": "0c5d9e32-b2af-4253-8df4-838ed9035c6f",
			"remote": true
		}
	]
}